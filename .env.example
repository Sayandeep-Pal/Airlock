# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# Production: reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Development: set to "true" to have the SDK print a debug token in the browser console,
# then register that token in Firebase console > App Check > Apps > Manage debug tokens.
# Or paste an already-registered debug token here.
VITE_APPCHECK_DEBUG_TOKEN=true

# Cloud model used for ONLY_IN_CLOUD / fallbacks. Check the current list at
# https://firebase.google.com/docs/ai-logic/models and update if needed.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
